# OpenAI-compatible model slots.
# A slot is enabled only when BASE_URL, API_KEY and MODEL are all present.

FAST_MODEL_BASE_URL=
FAST_MODEL_API_KEY=
FAST_MODEL_MODEL=

COGNITION_MODEL_BASE_URL=
COGNITION_MODEL_API_KEY=
COGNITION_MODEL_MODEL=

RESEARCH_MODEL_BASE_URL=
RESEARCH_MODEL_API_KEY=
RESEARCH_MODEL_MODEL=

WRITING_MODEL_BASE_URL=
WRITING_MODEL_API_KEY=
WRITING_MODEL_MODEL=

CRITIC_MODEL_BASE_URL=
CRITIC_MODEL_API_KEY=
CRITIC_MODEL_MODEL=


# Optional cost telemetry / protection.
# Rates are RMB per 1M tokens. Leave blank/0 if the provider is free or pricing is unknown.
# AI_24H_BUDGET_CNY is a rolling 24-hour global soft stop. 0 = unlimited.
AI_24H_BUDGET_CNY=0

FAST_MODEL_INPUT_CNY_PER_M=0
FAST_MODEL_OUTPUT_CNY_PER_M=0
FAST_MODEL_24H_CALL_LIMIT=0

COGNITION_MODEL_INPUT_CNY_PER_M=0
COGNITION_MODEL_OUTPUT_CNY_PER_M=0
COGNITION_MODEL_24H_CALL_LIMIT=0

RESEARCH_MODEL_INPUT_CNY_PER_M=0
RESEARCH_MODEL_OUTPUT_CNY_PER_M=0
RESEARCH_MODEL_24H_CALL_LIMIT=0

WRITING_MODEL_INPUT_CNY_PER_M=0
WRITING_MODEL_OUTPUT_CNY_PER_M=0
WRITING_MODEL_24H_CALL_LIMIT=0

CRITIC_MODEL_INPUT_CNY_PER_M=0
CRITIC_MODEL_OUTPUT_CNY_PER_M=0
CRITIC_MODEL_24H_CALL_LIMIT=0
