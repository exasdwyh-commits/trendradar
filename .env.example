# ─────────────────────────────────────────────────────────────────────────────
# TrendRadar 写作台 (creation platform + opportunity radar) — environment
# Copy to .env. Everything is optional: with no keys the system runs in
# degraded/mock mode and the UI labels every derived object accordingly.
# ─────────────────────────────────────────────────────────────────────────────

# Model slots (OpenAI-compatible chat/completions). A slot is enabled only when
# BASE_URL, API_KEY and MODEL are all set.
#   FAST_MODEL      cheap: classification, relevance, labels, product insights
#   ANALYSIS_MODEL  reasoning: cluster analysis, opportunity generation, scoring reasons, Ask
FAST_MODEL_BASE_URL=https://api.agnes-ai.cn/v1
FAST_MODEL_API_KEY=
FAST_MODEL_MODEL=agnes-3.0-flash

ANALYSIS_MODEL_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
ANALYSIS_MODEL_API_KEY=
ANALYSIS_MODEL_MODEL=mimo-v2.6-pro

# Optional dedicated writing slot for the 写作台 (选题角度 / 大纲 / 初稿 / 改写 /
# 标题 / 平台版本). If unset, ANALYSIS_MODEL is used for writing. Pick a model
# that writes good Chinese; the prompts only allow facts from bound materials.
WRITING_MODEL_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
WRITING_MODEL_API_KEY=
WRITING_MODEL_MODEL=mimo-v2.6-pro

# Embeddings (OpenAI-compatible /embeddings). If unset, a local hashed-ngram
# embedding is used (works offline, lower quality, flagged as "degraded").
EMBEDDING_MODEL_BASE_URL=
EMBEDDING_MODEL_API_KEY=
EMBEDDING_MODEL_MODEL=

# Product Hunt — supply-side tier-1 source.
#   graphql : live API v2 (developer token from https://www.producthunt.com/v2/oauth/applications)
#   mock    : bundled fixtures (default when no token)
PRODUCTHUNT_MODE=mock
PRODUCTHUNT_TOKEN=

# Optional demand sources
GITHUB_TOKEN=
REDDIT_USER_AGENT=
REDDIT_ENABLED=false

# Cost protection (RMB per 1M tokens; 0 = unknown/free). Rolling 24h soft stops.
AI_24H_BUDGET_CNY=0
FAST_MODEL_INPUT_CNY_PER_M=0
FAST_MODEL_OUTPUT_CNY_PER_M=0
FAST_MODEL_24H_CALL_LIMIT=0
ANALYSIS_MODEL_INPUT_CNY_PER_M=0
ANALYSIS_MODEL_OUTPUT_CNY_PER_M=0
ANALYSIS_MODEL_24H_CALL_LIMIT=0
WRITING_MODEL_INPUT_CNY_PER_M=0
WRITING_MODEL_OUTPUT_CNY_PER_M=0
WRITING_MODEL_24H_CALL_LIMIT=0
EMBEDDING_MODEL_INPUT_CNY_PER_M=0
EMBEDDING_MODEL_24H_CALL_LIMIT=0

# Easel 发布桥接（docs/EASEL_BRIDGE.md）。TrendRadar 不直连平台 API，handoff 包
# 默认写到 <DATA_DIR>/easel_outbox；把 EASEL_OUTBOX 指到 Easel 的工作目录即可让
# Easel Agent 直接在同一个目录里取包发布。留空 = 用默认位置。
EASEL_OUTBOX=

# Scheduler
TIMEZONE=Asia/Shanghai
DAILY_HOUR=1

# Server
HOST=127.0.0.1
PORT=8787
# 安全：API 无登录，默认只接受本机 Host（防 DNS rebinding）与本机 / Vite 来源的写请求（防跨站调用）。
# 局域网或反向代理访问时，把域名 / IP 加进 ALLOWED_HOSTS（逗号分隔，* = 不校验 Host）；
# 前端部署在其他域名时，把完整来源加进 CORS_ORIGINS，例如 https://radar.example.com
ALLOWED_HOSTS=
CORS_ORIGINS=
DATA_DIR=data
LOG_LEVEL=INFO
